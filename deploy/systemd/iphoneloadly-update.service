[Unit]
Description=iPhoneLoadly verified self-updater
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/iphoneloadly/update-iphoneloadly.sh
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/opt/iphoneloadly /etc/systemd/system /usr/local/libexec/iphoneloadly /var/lib/iphoneloadly /run/iphoneloadly
