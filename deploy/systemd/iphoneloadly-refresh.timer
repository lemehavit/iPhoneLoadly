[Unit]
Description=Retry due iPhoneLoadly IPA refreshes hourly

[Timer]
# A due app is at least six days old. Running hourly provides many bounded
# opportunities to catch an iPhone that was asleep or temporarily off Wi-Fi.
OnCalendar=hourly
Persistent=true
RandomizedDelaySec=10m
Unit=iphoneloadly-refresh.service

[Install]
WantedBy=timers.target
