# Root-readable configuration for iphoneloadly-api.service.
# Do not put an Apple-ID password or a two-factor code in this file.
RUST_LOG=info
IPHONELOADLY_ANISETTE_URL=http://127.0.0.1:6970
# netmuxd supplies current Wi-Fi device addresses. Do not configure a device IP or UDID.
IPHONELOADLY_MUX_SOCKET=/run/iphoneloadly/mux.sock
IPHONELOADLY_PAIRING_DIR=/var/lib/lockdown
