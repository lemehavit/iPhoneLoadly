# Root-readable configuration for iphoneloadly-api.service.
# Do not put an Apple-ID password or a two-factor code in this file.
RUST_LOG=info
IPHONELOADLY_ANISETTE_URL=http://127.0.0.1:6970
IPHONELOADLY_DEVICE_ID=REPLACE-WITH-LOCAL-DEVICE-ID
IPHONELOADLY_DEVICE_IP=REPLACE-WITH-IPHONE-IP
IPHONELOADLY_PAIRING_FILE=/var/lib/lockdown/REPLACE-WITH-YOUR-UDID.plist
