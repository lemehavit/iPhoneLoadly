# Copy this file to /etc/caddy/Caddyfile. Replace the username and password
# hash before reloading Caddy. The API itself listens only on 127.0.0.1.
https://iphoneloadly.local {
	tls internal
	basic_auth {
		REPLACE-WITH-DASHBOARD-USERNAME REPLACE-WITH-CADDY-PASSWORD-HASH
	}
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		-Server
	}
	reverse_proxy 127.0.0.1:8080
}
